  "firestore": {
    "/teachers/{teacherUid}": {
      "schema": { "$ref": "#/entities/TeacherProfile" },
      "description": "Teacher profile and app settings owned by teacherUid (deletable by owner or verified platform admin)."
    },
    "/teacherRosterStudents/{studentDocId}": {
      "schema": { "$ref": "#/entities/RosterStudent" },
      "description": "Teacher-managed student roster containing RUN and PIN."
    },
    "/studentDirectory/{accessCode}": {
      "schema": { "$ref": "#/entities/StudentDirectoryEntry" },
      "description": "Non-PII credential lookup keyed by uppercase student accessCode with SHA-256 PIN hash."
    },
    "/courseJoinCodes/{joinCode}": {
      "schema": { "$ref": "#/entities/CourseJoinCode" },
      "description": "Private class join directory looked up strictly by exact joinCode (QR or teacher-shared code), never publicly listed across schools."
    },
    "/courseMembers/{memberDocId}": {
      "schema": { "$ref": "#/entities/CourseMember" },
      "description": "Enrollment binding between authenticated student UID and teacher course."
    },
    "/courseFeeds/{courseFeedId}": {
      "schema": { "$ref": "#/entities/CourseFeed" },
      "description": "Real-time feed of active assignment IDs per teacher course."
    },
    "/assignments/{assignmentDocId}": {
      "schema": { "$ref": "#/entities/QuizAssignmentDoc" },
      "description": "Evaluations and SIMCE essays created by teachers for their courses."
    },
    "/attempts/{attemptDocId}": {
      "schema": { "$ref": "#/entities/QuizAttemptDoc" },
      "description": "Student quiz attempts and grades visible to both the student and owner teacher."
    }
  }
}
