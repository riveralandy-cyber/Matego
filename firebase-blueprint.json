        }
      },
      "required": [
        "id",
        "ownerUid",
        "studentUid",
        "quizId",
        "assignmentDocId",
        "quizTitle",
        "oaCode",
        "axis",
        "studentId",
        "studentName",
        "courseId",
        "teacherId",
        "answers",
        "score",
        "totalQuestions",
        "percentage",
        "chileanGrade",
